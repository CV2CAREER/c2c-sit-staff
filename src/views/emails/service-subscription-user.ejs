<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        color: #474747;
        width: 100%;
        background-color: #fff;
        text-align: justify;
        line-height: 1.6;
      }

      .header {
        background-color: #004174;
        background:
          linear-gradient(90deg, #004174 0%, #00568f 100%);
        width: 100%;
        height: 112px;
        text-align: center;
        display: table;
      }

      .header-content {
        display: table-cell;
        vertical-align: middle;
      }

      .header img {
        width: 149px;
        height: 32px;
      }

      .content {
        font-family: "Poppins", sans-serif;
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }

      .title {
        font-size: 22px;
        font-weight: 500;
        line-height: 32px;
        color: #474747;
        text-transform: capitalize;
        margin-bottom: 20px;
      }

      .body-content {
        background-color: #fff;
        width: 100%;
      }

      .body-content p {
        margin-bottom: 16px;
      }

      .body-content b {
        display: block;
        margin-bottom: 16px;
      }

      .signature {
        margin-top: 24px;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 32px 16px;
        text-align: center;
      }

      .footer-logo {
        margin-bottom: 16px;
      }

      .footer-logo img {
        width: 35px;
        height: 25px;
      }

      .social-links {
        margin: 16px auto;
      }

      .social-links a {
        text-decoration: none;
        vertical-align: middle;
        display: inline-block;
        padding: 0 6px;
      }

      .social-links img {
        width: 24px;
        height: 24px;
        border: 0;
      }

      .copyright {
        margin: 16px auto;
      }

      .footer-links {
        margin-top: 16px;
      }

      .footer-links a {
        text-decoration: none;
        color: #a3a3a3;
      }

      .contact-link {
        color: #004174;
        text-decoration: none;
      }

      .success-box {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
        text-align: center;
      }

      .success-box h2 {
        color: #155724;
        margin-bottom: 10px;
      }

      .success-icon {
        font-size: 48px;
        margin-bottom: 10px;
      }

      .plan-details {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
      }

      .plan-details h3 {
        color: #004174;
        margin-bottom: 15px;
        border-bottom: 2px solid #004174;
        padding-bottom: 10px;
      }

      .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #e9ecef;
      }

      .detail-label {
        font-weight: 600;
        color: #6c757d;
      }

      .detail-value {
        color: #004174;
        font-weight: 500;
      }

      .cta-button {
        display: inline-block;
        background-color: #004174;
        color: #ffffff;
        padding: 12px 30px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 500;
        margin: 20px 0;
      }

      .cta-button:hover {
        background-color: #00325a;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
      <div style="background-color: #004174; padding: 28px 32px; text-align: center">
        <img 
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801" 
          alt="CVtoCAREER Logo" 
          style="display: block; margin: 0 auto 16px auto; width: 149px; height: 32px"
        />
      </div>

    <!-- Content -->
    <div class="content">
      <div class="success-box">
        <div class="success-icon">✅</div>
        <h2>Payment Successful!</h2>
        <p>Your service has been activated successfully.</p>
      </div>

      <h1 class="title">Service Activated - <%= plan %></h1>

      <div class="body-content">
        <b>Dear <%= name %>,</b>

        <p>
          Congratulations! Your payment has been successfully processed and your
          <strong><%= plan %></strong> service at
          <a href="<%= frontendUrl %>" class="contact-link">CVtoCAREER</a> is now active.
        </p>

        <div class="plan-details">
          <h3>Subscription Details</h3>
          <div class="detail-row">
            <span class="detail-label">Service Plan:</span>
            <span class="detail-value"><%= plan %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Status:</span>
            <span class="detail-value" style="color: #28a745;">Active</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Activation Date:</span>
            <span class="detail-value"><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
        </div>

        <p>
          You can now access all the features included in your plan. Log in to your
          <a href="<%= frontendUrl %>/dashboard" class="contact-link">dashboard</a>
          to get started with your career journey.
        </p>

        <p>
          A separate email with your Terms & Conditions document will be sent to you shortly.
          Please keep this document for your records.
        </p>

        <p>
          If you have any questions or need assistance, please don't hesitate to contact our
          support team at
          <a href="mailto:deliveryteam@cvtocareer.com" class="contact-link">deliveryteam@cvtocareer.com</a>.
        </p>

        <div style="text-align: center;">
          <a href="<%= frontendUrl %>/dashboard" class="cta-button">Go to Dashboard</a>
        </div>

        <div class="signature">
          <p>Best regards,<br />CVtoCAREER Team</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
      <div
        style="
          padding: 16px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>
      </div>
  </body>
</html>