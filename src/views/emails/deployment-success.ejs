<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Deployment Successful</title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f4f4f5;
      padding: 40px;
      color: #333;
    "
  >
    <div
      style="
        max-width: 560px;
        margin: 0 auto;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div style="background-color: #16a34a; padding: 28px 32px">
        <h1 style="margin: 0; color: #fff; font-size: 20px">
          ✅ Deployment Successful
        </h1>
        <p style="margin: 6px 0 0; color: #bbf7d0; font-size: 14px">
          <%= appName %> is live
        </p>
      </div>

      <!-- Body -->
      <div style="padding: 28px 32px">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px">
          <tr>
            <td
              style="
                padding: 10px 0;
                color: #6b7280;
                width: 40%;
                border-bottom: 1px solid #f0f0f0;
              "
            >
              Service
            </td>
            <td
              style="
                padding: 10px 0;
                font-weight: 600;
                border-bottom: 1px solid #f0f0f0;
              "
            >
              <%= appName %>
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 0;
                color: #6b7280;
                border-bottom: 1px solid #f0f0f0;
              "
            >
              Environment
            </td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0">
              <span
                style="
                  background-color: #c9f0e0;
                  color: #0f7e4f;
                  padding: 2px 10px;
                  border-radius: 999px;
                  font-size: 12px;
                  font-weight: 600;
                "
                ><%= environment %></span
              >
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 0;
                color: #6b7280;
                border-bottom: 1px solid #f0f0f0;
              "
            >
              Commit
            </td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0">
              <code
                style="
                  background: #f4f4f5;
                  padding: 2px 6px;
                  border-radius: 4px;
                  font-size: 12px;
                "
                ><%= commitSha.slice(0, 7) %></code
              >
              <span style="margin-left: 8px; color: #374151"
                ><%= commitMessage %></span
              >
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 0;
                color: #6b7280;
                border-bottom: 1px solid #f0f0f0;
              "
            >
              Deployed by
            </td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0">
              <%= deployedBy %>
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 0;
                color: #6b7280;
                border-bottom: 1px solid #f0f0f0;
              "
            >
              Duration
            </td>
            <td style="padding: 10px 0; border-bottom: 1px solid #f0f0f0">
              <%= duration %>
            </td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #6b7280">Timestamp</td>
            <td style="padding: 10px 0"><%= timestamp %></td>
          </tr>
        </table>

        <!-- CTA Buttons -->
        <div style="margin-top: 28px; display: flex; gap: 12px">
          <a
            href="<%= deploymentUrl %>"
            style="
              display: inline-block;
              padding: 10px 20px;
              background-color: #16a34a;
              color: #fff;
              text-decoration: none;
              border-radius: 6px;
              font-size: 14px;
              font-weight: 600;
            "
            >View Deployment</a
          >
          <a
            href="<%= logsUrl %>"
            style="
              display: inline-block;
              padding: 10px 20px;
              background-color: #f4f4f5;
              color: #374151;
              text-decoration: none;
              border-radius: 6px;
              font-size: 14px;
              font-weight: 600;
            "
            >View Logs</a
          >
        </div>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 16px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          Sent by your deployment pipeline · <%= currentYear %>
        </p>
      </div>
    </div>
  </body>
</html>
