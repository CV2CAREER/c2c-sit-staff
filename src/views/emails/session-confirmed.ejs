<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Poppins", sans-serif; color: #474747; width: 100%; background-color: #fff; text-align: justify; line-height: 1.6; }
      .header { background: linear-gradient(90deg, #004174 0%, #00568f 100%); width: 100%; height: 112px; text-align: center; display: table; }
      .header-content { display: table-cell; vertical-align: middle; }
      .header img { width: 149px; height: 32px; }
      .content { font-family: "Poppins", sans-serif; padding: 20px; max-width: 600px; margin: 0 auto; }
      .title { font-size: 22px; font-weight: 500; line-height: 32px; color: #474747; text-transform: capitalize; margin-bottom: 20px; }
      .body-content { background-color: #fff; width: 100%; }
      .body-content p { margin-bottom: 16px; }
      .success-box { background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; padding: 20px; margin: 20px 0; text-align: center; }
      .success-box h2 { color: #155724; margin-bottom: 8px; }
      .success-icon { font-size: 48px; margin-bottom: 10px; }
      .session-details { background-color: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0; }
      .session-details h3 { color: #004174; margin-bottom: 15px; border-bottom: 2px solid #004174; padding-bottom: 10px; }
      .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e9ecef; }
      .detail-label { font-weight: 600; color: #6c757d; }
      .detail-value { color: #004174; font-weight: 500; }
      .cta-button { display: inline-block; background-color: #004174; color: #ffffff; padding: 12px 30px; border-radius: 6px; text-decoration: none; font-weight: 500; margin: 20px 0; }
      .meet-link { display: inline-block; background-color: #1a73e8; color: #ffffff; padding: 12px 30px; border-radius: 6px; text-decoration: none; font-weight: 500; margin: 8px 0; }
      .contact-link { color: #004174; text-decoration: none; }
      .signature { margin-top: 24px; }
      .footer { background-color: #f9f9f9; padding: 32px 16px; text-align: center; }
      .footer-logo { margin-bottom: 16px; }
      .footer-logo img { width: 35px; height: 25px; }
      .social-links { margin: 16px auto; }
      .social-links a { text-decoration: none; vertical-align: middle; display: inline-block; padding: 0 6px; }
      .social-links img { width: 24px; height: 24px; border: 0; }
      .copyright { margin: 16px auto; }
      .footer-links { margin-top: 16px; }
      .footer-links a { text-decoration: none; color: #a3a3a3; }
    </style>
  </head>
  <body>
    <!-- Header -->
      <div style="background-color: #004174; padding: 28px 32px; text-align: center">
        <img 
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801" 
          alt="CVtoCAREER Logo" 
          style="display: block; margin: 0 auto 16px auto; width: 149px; height: 32px"
        />
      </div>

    <div class="content">
      <div class="success-box">
        <div class="success-icon">✅</div>
        <h2>Session Confirmed!</h2>
        <p>Your coaching session has been booked successfully.</p>
      </div>

      <h1 class="title">Your Session is Confirmed</h1>

      <div class="body-content">
        <p><b>Dear <%= name %>,</b></p>

        <p>
          Great news! Your coaching session with <strong><%= coachName %></strong> has been confirmed.
          Please find your session details below.
        </p>

        <div class="session-details">
          <h3>Session Details</h3>
          <div class="detail-row">
            <span class="detail-label">Date:</span>
            <span class="detail-value"><%= date %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Time:</span>
            <span class="detail-value"><%= time %> (<%= timezone %>)</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Duration:</span>
            <span class="detail-value"><%= duration %> minutes</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Session Type:</span>
            <span class="detail-value" style="text-transform: capitalize;"><%= sessionType.replace(/_/g, ' ') %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Coach:</span>
            <span class="detail-value"><%= coachName %></span>
          </div>
        </div>

        <p>Join your session at the scheduled time using the button below:</p>

        <div style="text-align: center;">
          <a href="<%= meetingLink %>" class="meet-link">Join Meeting</a>
        </div>

        <p style="margin-top: 16px;">
          Or copy this link: <a href="<%= meetingLink %>" class="contact-link"><%= meetingLink %></a>
        </p>

        <p>
          If you need to reschedule or have any questions, please reach out to us at
          <a href="mailto:deliveryteam@cvtocareer.com" class="contact-link">deliveryteam@cvtocareer.com</a>.
        </p>

        <div style="text-align: center;">
          <a href="<%= frontendUrl %>/dashboard" class="cta-button">Go to Dashboard</a>
        </div>

        <div class="signature">
          <p>Best regards,<br />CVtoCAREER Team</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
      <div
        style="
          padding: 16px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>
      </div>
  </body>
</html>
