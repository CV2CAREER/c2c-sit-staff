<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="font-family: 'Segoe UI', Arial, sans-serif; background: #f4f4f5; padding: 32px 16px; color: #333; margin: 0; line-height: 1.6">
    <div style="max-width: 600px; margin: 0 auto; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08)">
      <div style="background: #1e3a5f; padding: 24px 32px; text-align: center">
        <h1 style="margin: 0; color: #fff; font-size: 20px; font-weight: 700">[Internal] Referral <%= action %></h1>
        <p style="margin: 8px 0 0; color: #bdd3e8; font-size: 13px">CVtoCAREER — Delivery Team Notification</p>
      </div>
      <div style="padding: 28px 32px">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px">
          <tr>
            <td style="padding: 8px 0; color: #555; width: 40%"><strong>Referral Type</strong></td>
            <td style="padding: 8px 0; color: #333"><%= referralType %></td>
          </tr>
          <tr style="background: #f9fafb">
            <td style="padding: 8px 0; color: #555"><strong>Action</strong></td>
            <td style="padding: 8px 0; color: #333"><%= action %></td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #555"><strong>Referrer</strong></td>
            <td style="padding: 8px 0; color: #333"><%= referrerName %> &lt;<%= referrerEmail %>&gt;</td>
          </tr>
          <tr style="background: #f9fafb">
            <td style="padding: 8px 0; color: #555"><strong>Referee</strong></td>
            <td style="padding: 8px 0; color: #333"><%= refereeName %> &lt;<%= refereeEmail %>&gt;</td>
          </tr>
          <% if (extra) { %>
          <tr>
            <td style="padding: 8px 0; color: #555"><strong>Details</strong></td>
            <td style="padding: 8px 0; color: #333"><%= extra %></td>
          </tr>
          <% } %>
        </table>
        <div style="margin-top: 24px">
          <a href="<%= adminUrl %>" style="background: #1e3a5f; color: #fff; text-decoration: none; font-weight: 600; padding: 12px 28px; border-radius: 6px; display: inline-block; font-size: 14px">
            View in Admin &rarr;
          </a>
        </div>
      </div>
      <div style="padding: 16px 32px; background: #f8f9fa; border-top: 1px solid #e5e7eb; text-align: center">
        <p style="margin: 0; font-size: 12px; color: #9ca3af">&copy; <%= currentYear %> CVtoCAREER PTY LTD &mdash; Internal Use Only</p>
      </div>
    </div>
  </body>
</html>
