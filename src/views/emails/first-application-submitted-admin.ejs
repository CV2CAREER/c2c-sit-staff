<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>First Application Sent — Delivery Team Notice</title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f4f4f5;
      padding: 40px;
      color: #333;
      margin: 0;
      line-height: 1.6;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background-color: #008ed3;
          padding: 28px 32px;
          text-align: center;
        "
      >
        <div
          style="
            background-color: #ffffff;
            display: inline-block;
            padding: 8px 20px;
            border-radius: 8px;
            margin-bottom: 16px;
          "
        >
          <img
            src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
            alt="CVtoCAREER Logo"
            style="display: block; width: 149px; height: 32px"
          />
        </div>
        <h1 style="margin: 0; color: #fff; font-size: 22px">
          First Application Sent
        </h1>
        <p style="margin: 8px 0 0; color: #d0eaf9; font-size: 13px">
          CVtoCAREER &mdash; Delivery Team Notification
        </p>
      </div>

      <!-- Body -->
      <div style="padding: 28px 32px">
        <p style="margin: 0 0 16px">Hi team,</p>

        <p style="margin: 0 0 16px">
          The first job application for the following client has just gone out
          &mdash; their journey step &ldquo;Applications Started&rdquo; has been
          recorded automatically.
        </p>

        <div
          style="
            background-color: #f0f7fc;
            border-left: 4px solid #008ed3;
            padding: 14px 16px;
            border-radius: 4px;
            margin: 20px 0;
          "
        >
          <p style="margin: 0 0 6px; color: #333">
            <strong>Client:</strong> <%= clientName %>
          </p>
          <p style="margin: 0 0 6px; color: #333">
            <strong>Email:</strong> <%= clientEmail %>
          </p>
          <p style="margin: 0; color: #333">
            <strong>Plan:</strong> <%= plan %>
          </p>
        </div>

        <div style="text-align: center; margin: 28px 0 8px">
          <a
            href="<%= link %>"
            style="
              background-color: #008ed3;
              color: #fff;
              text-decoration: none;
              font-weight: bold;
              padding: 12px 32px;
              border-radius: 6px;
              display: inline-block;
              font-size: 14px;
            "
          >
            Open client profile &rarr;
          </a>
        </div>

        <p style="margin: 24px 0 0 0; color: #6b7280; font-size: 13px">
          &mdash; CVtoCAREER System
        </p>
      </div>

      <!-- Footer -->
      <% var siteUrl = (typeof frontendUrl !== "undefined" && frontendUrl) ? frontendUrl : "https://app.cvtocareer.com"; %>
      <div
        style="
          padding: 24px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <div style="margin-bottom: 20px">
          <a
            href="https://facebook.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png"
              alt="Facebook"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://x.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png"
              alt="X"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://youtube.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_yt.png"
              alt="YouTube"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="mailto:support@cvtocareer.com"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_gmail.png"
              alt="Email"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://instagram.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png"
              alt="Instagram"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://linkedin.com/company/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png"
              alt="LinkedIn"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
        </div>

        <p style="margin: 0 0 12px; font-size: 12px; color: #9ca3af">
          &copy; <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>

        <div style="margin: 8px 0">
          <a
            href="<%= siteUrl %>/dashboard/account?run=unsubscribe"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Unsubscribe</a
          >
          <span style="color: #d1d5db">|</span>
          <a
            href="<%= siteUrl %>/privacy-policy"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Privacy Policy</a
          >
          <span style="color: #d1d5db">|</span>
          <a
            href="<%= siteUrl %>"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Website</a
          >
        </div>
      </div>
    </div>
  </body>
</html>
