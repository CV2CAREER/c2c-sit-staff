<!-- views/emails/new-referral-alert.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        color: #474747;
        width: 100%;
        background-color: #fff;
        text-align: justify;
        line-height: 1.6;
      }

      .header {
        background-color: #004174;
        background:
          linear-gradient(90deg, #004174 0%, #00568f 100%);
        width: 100%;
        height: 112px;
        text-align: center;
        display: table;
      }

      .header-content {
        display: table-cell;
        vertical-align: middle;
      }

      .header img {
        width: 149px;
        height: 32px;
      }

      .content {
        font-family: "Poppins", sans-serif;
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }

      .title {
        font-size: 22px;
        font-weight: 500;
        line-height: 32px;
        color: #474747;
        text-transform: capitalize;
        margin-bottom: 20px;
      }

      .body-content {
        background-color: #fff;
        width: 100%;
      }

      .body-content p {
        margin-bottom: 16px;
      }

      .body-content b {
        display: block;
        margin-bottom: 16px;
      }

      .signature {
        margin-top: 24px;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 32px 16px;
        text-align: center;
      }

      .footer-logo {
        margin-bottom: 16px;
      }

      .footer-logo img {
        width: 35px;
        height: 25px;
      }

      .social-links {
        margin: 16px auto;
      }

      .social-links a {
        text-decoration: none;
        vertical-align: middle;
        display: inline-block;
        padding: 0 6px;
      }

      .social-links img {
        width: 24px;
        height: 24px;
        border: 0;
      }

      .copyright {
        margin: 16px auto;
      }

      .footer-links {
        margin-top: 16px;
      }

      .footer-links a {
        text-decoration: none;
        color: #a3a3a3;
      }

      .contact-link {
        color: #004174;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
      <div style="background-color: #004174; padding: 28px 32px; text-align: center">
        <img 
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801" 
          alt="CVtoCAREER Logo" 
          style="display: block; margin: 0 auto 16px auto; width: 149px; height: 32px"
        />
      </div>

    <!-- Content -->
    <div class="content">
      <h1 class="title">New Referral Alert</h1>

      <div class="body-content">
        <b>Dear <%= name %></b>

        <p>
          We are happy to inform you that <strong><%= refname %></strong> just
          signed up using your referral code.
        </p>

        <p>
          Kindly login to your Dashboard to track the user and also follow up on
          them to get the best of the platform.
        </p>

        <p>
          For more information, reach out to us via our
          <a href="<%= frontendUrl %>/contact-us %>" class="contact-link"
            >Contact Us</a
          >
          page.
        </p>

        <div class="signature">
          <p>Best regards,<br />CVtoCAREER</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
      <div
        style="
          padding: 16px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>
      </div>
  </body>
</html>
