<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Poppins", sans-serif; color: #474747; width: 100%; background-color: #fff; text-align: justify; line-height: 1.6; }
      .header { background: linear-gradient(90deg, #004174 0%, #00568f 100%); width: 100%; height: 112px; text-align: center; display: table; }
      .header-content { display: table-cell; vertical-align: middle; }
      .header img { width: 149px; height: 32px; }
      .content { font-family: "Poppins", sans-serif; padding: 20px; max-width: 600px; margin: 0 auto; }
      .title { font-size: 22px; font-weight: 500; line-height: 32px; color: #474747; text-transform: capitalize; margin-bottom: 20px; }
      .body-content { background-color: #fff; width: 100%; }
      .body-content p { margin-bottom: 16px; }
      .body-content b { display: block; margin-bottom: 16px; }
      .signature { margin-top: 24px; }
      .alert-box { border-radius: 8px; padding: 20px; margin: 20px 0; }
      .alert-box.start { background-color: #d4edda; border: 1px solid #c3e6cb; }
      .alert-box.end { background-color: #fff3cd; border: 1px solid #ffc107; }
      .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e9ecef; }
      .detail-label { font-weight: 600; color: #6c757d; }
      .detail-value { color: #004174; font-weight: 500; }
      .details-box { background-color: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0; }
      .details-box h3 { color: #004174; margin-bottom: 15px; border-bottom: 2px solid #004174; padding-bottom: 10px; }
      .footer { background-color: #f9f9f9; padding: 32px 16px; text-align: center; }
      .copyright { margin: 16px auto; }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="header-content">
        <img src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801" alt="CV To Career" />
      </div>
    </div>

    <div class="content">
      <% if (action === 'start') { %>
      <div class="alert-box start">
        <strong>🚀 Application Commenced</strong> — A client's application has been started.
      </div>
      <h1 class="title">Application Commenced – Admin Notification</h1>
      <% } else { %>
      <div class="alert-box end">
        <strong>⏸️ Application Expired</strong> — A client's application has been ended.
      </div>
      <h1 class="title">Application Expired – Admin Notification</h1>
      <% } %>

      <div class="body-content">
        <b>Team,</b>

        <p>
          This is an automated notification to inform you that the following client's application
          status has been updated by an admin.
        </p>

        <div class="details-box">
          <h3>Client Details</h3>
          <div class="detail-row">
            <span class="detail-label">Name:</span>
            <span class="detail-value"><%= name %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Email:</span>
            <span class="detail-value"><%= email %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Action:</span>
            <span class="detail-value"><%= action === 'start' ? 'Application Commenced' : 'Application Expired' %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Triggered By:</span>
            <span class="detail-value"><%= triggeredBy %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Date:</span>
            <span class="detail-value"><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
        </div>

        <div class="signature">
          <p>CVtoCAREER System</p>
        </div>
      </div>
    </div>

    <div class="footer">
      <p class="copyright">© <%= currentYear %> CVtoCAREER. All rights reserved.</p>
    </div>
  </body>
</html>
