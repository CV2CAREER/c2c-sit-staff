<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document Update - Admin Notification</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        color: #474747;
        width: 100%;
        background-color: #fff;
        text-align: justify;
        line-height: 1.6;
      }

      .header {
        background-color: #004174;
        width: 100%;
        height: 112px;
        text-align: center;
        display: table;
      }

      .header-content {
        display: table-cell;
        vertical-align: middle;
      }

      .header img {
        width: 149px;
        height: 32px;
      }

      .content {
        font-family: "Poppins", sans-serif;
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }

      .title {
        font-size: 22px;
        font-weight: 500;
        line-height: 32px;
        color: #474747;
        margin-bottom: 20px;
      }

      .body-content {
        background-color: #fff;
        width: 100%;
      }

      .body-content p {
        margin-bottom: 16px;
      }

      .info-box {
        background-color: #f0f7fc;
        border-left: 4px solid #004174;
        padding: 16px;
        margin: 20px 0;
      }

      .info-box p {
        margin-bottom: 8px;
      }

      .info-box p:last-child {
        margin-bottom: 0;
      }

      .btn {
        display: inline-block;
        background-color: #004174;
        color: #fff;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 16px;
      }

      .signature {
        margin-top: 24px;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 32px 16px;
        text-align: center;
      }

      .footer-logo img {
        width: 35px;
        height: 25px;
      }

      .copyright {
        margin: 16px auto;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <div class="header">
      <div class="header-content">
        <img
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
          alt="CV To Career"
        />
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <h1 class="title">Document Update Received</h1>

      <div class="body-content">
        <p>A user has updated their document.</p>

        <div class="info-box">
          <p><strong>User Details:</strong></p>
          <p><strong>Name:</strong> <%= userName %></p>
          <p><strong>Email:</strong> <%= userEmail %></p>
        </div>

        <p>
          The user has updated their resume/cover letter. Please log in to the 
          admin dashboard to review the updated documents.
        </p>

        <a href="<%= userLink %>" class="btn">View User Documents</a>

        <div class="signature">
          <p>Best regards,<br />CVtoCAREER System</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-logo">
        <img
          src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/laigusbucket/bea7d3a092f0710b014b1f203.png?GoogleAccessId=firebase-adminsdk-f76vf%40cvtocareer-394713.iam.gserviceaccount.com&Expires=4070905200&Signature=gWB9jqmAcwN9nLbugMdOj%2FD0BROrGRX4a8qnGa9cZGuOkc0Z2M9itk0pzUtoUtyedrxv%2B2hO%2BFqDqlduJ6J7WqVBAJ3wQ17oe72S5BwTvRXEY3Q7OM%2B9wuxsFsSwgrtfldf79sly6nIJQCXqb94FDFL661YxCbeGN%2BIq0j2volsUvmKtParJXXLo3LO%2BBmOms1nVf6HHldXbD%2FfMno5f%2FB8wj%2FLDF%2FvMk5LfTsISh0kSOXmvfRNQvktImOAH2rTt%2B6ejVByGrxstPLhViGGI0BSIWEOn0oFaihxHK3Lo%2B3T0WePp5Q0PoYFrERpTtGReyZFGIVc%2Bs%2B9PReVzHoL86g%3D%3D"
          alt="CVtoCAREER"
        />
      </div>

      <p class="copyright">
        © <%= currentYear %> CVtoCAREER. All rights reserved.
      </p>
    </div>
  </body>
</html>