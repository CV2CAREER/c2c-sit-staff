<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0; padding:0; font-family:'Poppins',Arial,Helvetica,sans-serif; width:100%; background-color:#F3F4F6; line-height:1.6; -webkit-font-smoothing:antialiased;">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#F3F4F6;">
    <tr>
      <td align="center" style="padding:0;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:560px; width:100%; margin:40px auto; background-color:#FFFFFF; border-radius:16px; overflow:hidden; border:1px solid #E5E7EB; box-shadow:0 1px 2px rgba(0,0,0,0.05), 0 4px 12px rgba(0,0,0,0.06);">
          <tr>
            <td style="background-color:#10365A; padding:32px 32px; text-align:center; border-bottom:3px solid #0E7FC2;">
              <img
                src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
                alt="CVtoCAREER Logo"
                style="display:block; margin:0 auto; width:149px; height:32px; border:0; outline:none;"
              />
            </td>
          </tr>
          <tr>
            <td style="padding:40px 36px;">
              <div style="display:inline-block; background-color:#E6F7F1; color:#0F9D6C; font-size:12px; font-weight:600; padding:5px 14px; border-radius:8px; margin-bottom:16px;">&#9679; Delivered</div>
              <h1 style="margin:0 0 16px; font-size:24px; font-weight:700; color:#1F2937; letter-spacing:-0.01em;">Delivery Confirmation</h1>
              <div style="font-size:14px; color:#4B5563;">
                <p style="margin:0 0 18px;">A missing information request was delivered to <strong><%= clientName %></strong>.</p>
                <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; border-collapse:collapse; margin:20px 0;">
                  <tr>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:40%; color:#6B7280; font-weight:500; background-color:#FAFBFC;" align="left">Client</td>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:60%; color:#1F2937; font-weight:500; background-color:#FAFBFC;" align="right"><%= clientName %></td>
                  </tr>
                  <tr>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:40%; color:#6B7280; font-weight:500;" align="left">Channel</td>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:60%; color:#1F2937; font-weight:500;" align="right"><%= channel %></td>
                  </tr>
                  <tr>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:40%; color:#6B7280; font-weight:500; background-color:#FAFBFC;" align="left">Template</td>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:60%; color:#1F2937; font-weight:500; background-color:#FAFBFC;" align="right"><%= templateName %></td>
                  </tr>
                  <tr>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:40%; color:#6B7280; font-weight:500;" align="left">Fields requested</td>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:60%; color:#1F2937; font-weight:500;" align="right"><%= fieldCount %></td>
                  </tr>
                  <tr>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:40%; color:#6B7280; font-weight:500; background-color:#FAFBFC;" align="left">Sent at</td>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:1px solid #E5E7EB; width:60%; color:#1F2937; font-weight:500; background-color:#FAFBFC;" align="right"><%= sentAt %></td>
                  </tr>
                  <% if (sentBy) { %>
                  <tr>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:none; width:40%; color:#6B7280; font-weight:500;" align="left">Sent by</td>
                    <td style="padding:10px 16px; font-size:14px; border-bottom:none; width:60%; color:#1F2937; font-weight:500;" align="right"><%= sentBy %></td>
                  </tr>
                  <% } %>
                </table>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:16px 0 0;">
                  <tr>
                    <td style="border-radius:10px;">
                      <a href="<%= requestUrl %>" style="display:inline-block; padding:15px 32px; background-color:#0E7FC2; background-image:linear-gradient(135deg, #0E7FC2 0%, #0B5A94 100%); color:#ffffff; text-decoration:none; border-radius:10px; font-weight:600; font-size:15px; letter-spacing:0.01em; text-align:center; box-shadow:0 2px 8px rgba(14,127,194,0.25);">View Request</a>
                    </td>
                  </tr>
                </table>
                <hr style="height:1px; background-color:#E5E7EB; border:none; margin:24px 0;" />
                <p style="font-size:13px; color:#9CA3AF; margin:0;">This is an automated notification from the C2C Platform.</p>
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px; border-top:1px solid #E5E7EB; text-align:center;">
              <p style="margin:0 0 4px; font-size:12px; color:#9CA3AF;">&copy; <%= currentYear %> CVtoCAREER. All rights reserved.</p>
              <p style="margin:0; font-size:12px; color:#9CA3AF;"><a href="mailto:deliveryteam@cvtocareer.com" style="color:#9CA3AF; text-decoration:underline;">deliveryteam@cvtocareer.com</a></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
