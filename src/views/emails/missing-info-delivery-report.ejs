<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f4f4f5;
      color: #474747;
      line-height: 1.6;
    "
  >
    <div style="max-width: 600px; margin: 0 auto; background: #fff">
      <!-- Header -->
      <div
        style="
          background-color: #008ed3;
          padding: 28px 32px;
          text-align: center;
        "
      >
        <div
          style="
            background-color: #ffffff;
            display: inline-block;
            padding: 8px 20px;
            border-radius: 8px;
            margin-bottom: 16px;
          "
        >
          <img
            src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
            alt="CVtoCAREER Logo"
            style="display: block; width: 149px; height: 32px"
          />
        </div>
        <h1 style="margin: 0; color: #fff; font-size: 22px">
          Delivery Confirmation
        </h1>
      </div>

      <!-- Body -->
      <div style="padding: 32px 28px">
        <span
          style="
            display: inline-block;
            background-color: #e6f7f1;
            color: #0f9d6c;
            font-size: 12px;
            font-weight: 600;
            padding: 5px 14px;
            border-radius: 8px;
            margin-bottom: 16px;
          "
          >&#9679; Delivered</span
        >

        <p style="margin: 0 0 16px">
          A missing information request was delivered to
          <strong><%= clientName %></strong>.
        </p>

        <table
          style="width: 100%; border-collapse: collapse; margin: 20px 0"
        >
          <tr>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #6b7280;
                font-weight: 500;
                background-color: #fafbfc;
              "
            >
              Client
            </td>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #1f2937;
                font-weight: 500;
                background-color: #fafbfc;
              "
              align="right"
            >
              <%= clientName %>
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #6b7280;
                font-weight: 500;
              "
            >
              Channel
            </td>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #1f2937;
                font-weight: 500;
              "
              align="right"
            >
              <%= channel %>
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #6b7280;
                font-weight: 500;
                background-color: #fafbfc;
              "
            >
              Template
            </td>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #1f2937;
                font-weight: 500;
                background-color: #fafbfc;
              "
              align="right"
            >
              <%= templateName %>
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #6b7280;
                font-weight: 500;
              "
            >
              Fields requested
            </td>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #1f2937;
                font-weight: 500;
              "
              align="right"
            >
              <%= fieldCount %>
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #6b7280;
                font-weight: 500;
                background-color: #fafbfc;
              "
            >
              Sent at
            </td>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                color: #1f2937;
                font-weight: 500;
                background-color: #fafbfc;
              "
              align="right"
            >
              <%= sentAt %>
            </td>
          </tr>
          <% if (sentBy) { %>
          <tr>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                color: #6b7280;
                font-weight: 500;
              "
            >
              Sent by
            </td>
            <td
              style="
                padding: 10px 16px;
                font-size: 14px;
                color: #1f2937;
                font-weight: 500;
              "
              align="right"
            >
              <%= sentBy %>
            </td>
          </tr>
          <% } %>
        </table>

        <div style="text-align: center; margin: 24px 0">
          <a
            href="<%= requestUrl %>"
            style="
              background-color: #008ed3;
              color: #fff;
              text-decoration: none;
              font-weight: 600;
              padding: 14px 32px;
              border-radius: 6px;
              display: inline-block;
              font-size: 15px;
            "
            >View Request</a
          >
        </div>

        <hr
          style="
            height: 1px;
            background-color: #e5e7eb;
            border: none;
            margin: 24px 0;
          "
        />

        <p style="font-size: 13px; color: #9ca3af; margin: 0">
          This is an automated notification from the C2C Platform.
        </p>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 24px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <div style="margin-bottom: 20px">
          <a
            href="https://facebook.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png"
              alt="Facebook"
              style="width: 28px; height: 28px"
            />
          </a>
          <a
            href="https://x.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png"
              alt="X"
              style="width: 28px; height: 28px"
            />
          </a>
          <a
            href="https://youtube.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_yt.png"
              alt="YouTube"
              style="width: 28px; height: 28px"
            />
          </a>
          <a
            href="mailto:support@cvtocareer.com"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_gmail.png"
              alt="Email"
              style="width: 28px; height: 28px"
            />
          </a>
          <a
            href="https://instagram.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png"
              alt="Instagram"
              style="width: 28px; height: 28px"
            />
          </a>
          <a
            href="https://linkedin.com/company/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png"
              alt="LinkedIn"
              style="width: 28px; height: 28px"
            />
          </a>
        </div>

        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          &copy; <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
