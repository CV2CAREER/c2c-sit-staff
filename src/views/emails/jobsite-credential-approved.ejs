<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="margin: 0; padding: 0; font-family: 'Poppins', Arial, sans-serif; width: 100%; background-color: #F3F4F6; line-height: 1.6; -webkit-font-smoothing: antialiased;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F3F4F6;">
      <tr>
        <td align="center">
          <div style="max-width: 560px; margin: 40px auto; background-color: #FFFFFF; border-radius: 16px; overflow: hidden; border: 1px solid #E5E7EB;">
            <!-- Header -->
            <div style="background-color: #10365A; padding: 32px 32px; text-align: center; border-bottom: 3px solid #0E7FC2;">
              <img
                src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2Fjobsite-credential-logo.png?alt=media&token=9d81b484-ab4b-41f0-b7cb-d88f2287b340"
                alt="CVtoCAREER Logo"
                style="display: block; margin: 0 auto; width: 149px; height: 32px;"
              />
            </div>

            <!-- Body -->
            <div style="padding: 40px 36px;">
              <div style="background-color: #F0FDF8; border-left: 5px solid #0F9D6C; border-radius: 8px; padding: 20px; margin: 0 0 24px; text-align: center;">
                <div style="display: inline-block; width: 56px; height: 56px; line-height: 56px; background-color: #0F9D6C; border-radius: 50%; color: #FFFFFF; font-size: 28px; font-weight: 700; text-align: center; margin-bottom: 12px;">&#10004;</div>
                <p style="margin: 0; font-weight: 600; color: #1F2937; font-size: 16px;">Email approved</p>
              </div>

              <div style="font-size: 14px; color: #4B5563;">
                <p style="margin: 0 0 18px;">Dear <strong><%= name %></strong>,</p>

                <p style="margin: 0 0 18px;"><strong><%= email %></strong> is now set as your application email.</p>

                <div style="background-color: #F0F7FF; border-left: 5px solid #0E7FC2; padding: 16px 20px; border-radius: 8px; margin: 20px 0;">
                  <p style="margin: 0 0 6px; font-weight: 500; color: #1F2937;">What happens next</p>
                  <ul style="margin: 0; padding-left: 18px; color: #4B5563;">
                    <% if (isAmbassador) { %>
                      <li style="margin-bottom: 8px;">Your Coral plan will be activated by our team shortly &mdash; this is the final step before applications begin</li>
                      <li style="margin-bottom: 8px;">You&rsquo;ll receive a &ldquo;Your Coral Plan Is Active&rdquo; notification when activation completes</li>
                    <% } else { %>
                      <li style="margin-bottom: 8px;">Applications are sent on your behalf using this email</li>
                      <li style="margin-bottom: 8px;">Replies from recruiters go directly to your inbox</li>
                    <% } %>
                    <li>You can update your credentials any time under Jobsite Credentials</li>
                  </ul>
                </div>

                <a href="<%= frontendUrl %>/dashboard/jobsite-credentials" style="display: block; margin-top: 24px; padding: 15px 32px; background-color: #0E7FC2; background-image: linear-gradient(135deg, #0E7FC2 0%, #0B5A94 100%); color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 15px; letter-spacing: 0.01em; text-align: center;">Go to Jobsite Credentials →</a>

                <div style="height: 1px; background-color: #E5E7EB; margin: 24px 0;"></div>

                <p style="margin: 0; font-size: 14px; color: #4B5563;">Kind regards,<br />The CVtoCAREER Team</p>
              </div>
            </div>

            <!-- Footer -->
            <div style="padding: 20px 32px; border-top: 1px solid #E5E7EB; text-align: center;">
              <p style="margin: 0; font-size: 12px; color: #9CA3AF;">
                &copy; <%= currentYear %> CVtoCAREER. All rights reserved.
              </p>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
