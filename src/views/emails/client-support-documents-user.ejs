<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f4f4f5;
      padding: 40px;
      color: #333;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background-color: #008ed3;
          padding: 28px 32px;
          text-align: center;
        "
      >
        <!-- Logo container with white background to match original design -->
        <div
          style="
            background-color: #ffffff;
            display: inline-block;
            padding: 8px 20px;
            border-radius: 8px;
            margin-bottom: 16px;
          "
        >
          <img
            src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
            alt="CVtoCAREER Logo"
            style="display: block; width: 149px; height: 32px"
          />
        </div>
        <h1 style="margin: 0; color: #fff; font-size: 22px">
          <%= title %> ✓
        </h1>
      </div>

      <!-- Body -->
      <div style="padding: 28px 32px">
        <!-- Success Icon -->
        <div style="text-align: center; margin: 0 0 24px 0">
          <img
            src="https://cdn-icons-png.flaticon.com/512/190/190411.png"
            alt="Success"
            style="width: 64px; height: 64px; display: inline-block"
          />
        </div>

        <p style="margin: 0 0 16px">Dear <strong><%= name %></strong>,</p>

        <p style="margin: 0 0 16px">
          Our team has shared new documents with you. Please find the details
          below.
        </p>

        <!-- Document details box -->
        <div
          style="
            background-color: #f0f7fc;
            border-left: 4px solid #008ed3;
            padding: 16px;
            margin: 24px 0;
            border-radius: 4px;
          "
        >
          <p style="margin: 0 0 8px; font-weight: bold; color: #004174">
            📄 Document Details
          </p>
          <p style="margin: 0 0 6px; font-size: 14px">
            <strong>Document(s):</strong> <%= documentNames %>
          </p>
          <p style="margin: 0 0 6px; font-size: 14px">
            <strong>Document Type(s):</strong> <%= documentTypes %>
          </p>
          <p style="margin: 0; font-size: 14px">
            <strong>Shared On:</strong> <%= timestamp %>
          </p>
        </div>

        <p style="margin: 0 0 16px">
          You can view and download them by logging into your
          <a
            href="<%= frontendUrl %>/dashboard"
            style="color: #008ed3; text-decoration: none; font-weight: bold"
            >CVtoCAREER dashboard</a
          >.
        </p>

        <% if (hasRoleTitles) { %>
        <!-- Role titles awaiting client confirmation -->
        <div
          style="
            background-color: #f5fdfe;
            border: 1px solid #008ed3;
            padding: 16px;
            margin: 24px 0;
            border-radius: 6px;
          "
        >
          <p style="margin: 0 0 8px; font-weight: bold; color: #004174">
            ✓ Your role titles need confirmation
          </p>
          <p style="margin: 0; font-size: 14px">
            Your role title recommendations need your confirmation. Open them and
            tell us which titles fit — and which don't. It takes a minute, and it
            decides what we apply for.
          </p>
        </div>
        <% } %>

        <!-- Dashboard Button -->
        <div style="text-align: center; margin: 28px 0 24px 0">
          <a
            href="<%= frontendUrl %>/dashboard"
            style="
              background-color: #008ed3;
              color: #fff;
              text-decoration: none;
              font-weight: bold;
              padding: 12px 32px;
              border-radius: 6px;
              display: inline-block;
              font-size: 15px;
            "
          >
            Go to Dashboard →
          </a>
        </div>

        <p style="margin: 0 0 16px">
          If you have any questions or need further assistance, please don't
          hesitate to
          <a
            href="mailto:support@cvtocareer.com"
            style="color: #008ed3; text-decoration: none; font-weight: bold"
            >contact our support team</a
          >.
        </p>

        <p style="margin: 24px 0 0 0">
          Best regards,<br />
          <strong>The CVtoCAREER Team</strong>
        </p>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 24px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <!-- Social Links -->
        <div style="margin-bottom: 20px">
          <a
            href="https://facebook.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png"
              alt="Facebook"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://x.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png"
              alt="X"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://youtube.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_yt.png"
              alt="YouTube"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="mailto:deliveryteam@cvtocareer.com"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_gmail.png"
              alt="Email"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://instagram.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png"
              alt="Instagram"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://linkedin.com/company/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png"
              alt="LinkedIn"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
        </div>

        <p style="margin: 0 0 12px; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>

        <div style="margin: 8px 0">
          <a
            href="<%= frontendUrl %>/dashboard/account?run=unsubscribe"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Unsubscribe</a
          >
          <span style="color: #d1d5db">|</span>
          <a
            href="<%= frontendUrl %>/privacy-policy"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Privacy Policy</a
          >
          <span style="color: #d1d5db">|</span>
          <a
            href="<%= frontendUrl %>"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Website</a
          >
        </div>
      </div>
    </div>
  </body>
</html>
