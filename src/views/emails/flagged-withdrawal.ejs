<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,600;0,700;1,700&display=swap"
      rel="stylesheet"
      type="text/css"
    />
    <title>PadiPlus</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f3f4f6;
        font-family: "Figtree", Helvetica, Arial, sans-serif;
      }
      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .cta-button:hover {
        transform: translateY(-2px);
      }

      @media only screen and (max-width: 480px) {
        .body-wrapper {
          padding: 5px !important;
        }

        .content-body {
          padding: 20px !important; /* Reduced padding for mobile */
        }
      }
    </style>
  </head>
  <body class="body-wrapper" style="background-color: #f3f4f6; padding: 20px">
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
    >
      <tr>
        <td align="center">
          <div class="email-container">
            <table
              width="100%"
              cellspacing="0"
              cellpadding="0"
              border="0"
              style="margin-top: 32px; margin-bottom: 16px"
            >
              <tr>
                <td align="center">
                  <table cellspacing="0" cellpadding="0" border="0">
                    <tr>
                      <td style="padding-right: 10px">
                        <img
                          src="cid:padiplus_logo"
                          alt="Padi Plus"
                          width="35"
                          height="35"
                          style="display: block; object-fit: cover"
                        />
                      </td>
                      <td style="text-align: left">
                        <h2
                          style="
                            margin: 0;
                            font-size: 24px;
                            font-weight: bold;
                            font-style: italic;
                            color: #4f426f;
                          "
                        >
                          Padi Plus
                        </h2>
                        <p
                          style="
                            margin: 0;
                            font-size: 10px;
                            color: #666;
                            margin-top: -2px;
                            font-family: 'Figtree', Helvetica, Arial, sans-serif;
                          "
                        >
                          Event Planning Made Easy
                        </p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <table
              width="100%"
              cellspacing="0"
              cellpadding="0"
              border="0"
              class="content-body"
              style="padding: 40px; background-color: #ffffff"
            >
              <tr>
                <td
                  valign="top"
                  style="font-family: 'Figtree', Helvetica, Arial, sans-serif"
                >
                  <h1
                    style="
                      font-size: 28px;
                      font-weight: bold;
                      color: #111827;
                      margin: 0 0 8px 0;
                      font-family: 'Figtree', Helvetica, Arial, sans-serif;
                    "
                  >
                    Withdrawal Restriction
                  </h1>
                  <p
                    style="
                      font-size: 14px;
                      color: #6b7280;
                      margin: 0 0 24px 0;
                      font-family: 'Figtree', Helvetica, Arial, sans-serif;
                    "
                  >
                    Security Review in Progress
                  </p>

                  <p
                    style="
                      font-size: 16px;
                      color: #1f2937;
                      line-height: 1.6;
                      margin-bottom: 24px;
                      font-family: 'Figtree', Helvetica, Arial, sans-serif;
                    "
                  >
                    Hi <strong><%= name %>,</strong> our automated system has
                    flagged the following withdrawal attempt for a standard
                    security review:
                  </p>

                  <table
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                      background-color: #f9fafb;
                      border: 1px solid #e5e7eb;
                      border-radius: 8px;
                      margin-bottom: 24px;
                    "
                  >
                    <tr>
                      <td style="padding: 16px">
                        <table
                          width="100%"
                          cellspacing="0"
                          cellpadding="0"
                          border="0"
                        >
                          <tr>
                            <td
                              style="
                                font-size: 13px;
                                color: #6b7280;
                                padding-bottom: 4px;
                              "
                            >
                              Amount
                            </td>
                            <td
                              style="
                                font-size: 13px;
                                color: #6b7280;
                                padding-bottom: 4px;
                                text-align: right;
                              "
                            >
                              Transaction ID
                            </td>
                          </tr>
                          <tr>
                            <td
                              style="
                                font-size: 18px;
                                font-weight: 700;
                                color: #111827;
                              "
                            >
                              <%= amount %>
                            </td>
                            <td
                              style="
                                font-size: 14px;
                                color: #111827;
                                text-align: right;
                                font-family: monospace;
                              "
                            >
                              <%= transactionId %>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>

                  <table
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                      background-color: #fff7ed;
                      border-radius: 8px;
                      margin-bottom: 24px;
                      border-left: 4px solid #f97316;
                    "
                  >
                    <tr>
                      <td style="padding: 20px">
                        <p
                          style="
                            font-size: 14px;
                            color: #9a3412;
                            margin: 0;
                            line-height: 1.5;
                          "
                        >
                          <strong>Action Taken: Withdrawal Lock</strong><br />
                          To protect your funds, withdrawal features have been
                          temporarily locked. This is a precautionary measure
                          while we verify this activity.
                        </p>
                      </td>
                    </tr>
                  </table>

                  <p
                    style="
                      font-size: 14px;
                      color: #6b7280;
                      line-height: 1.6;
                      margin-bottom: 24px;
                      font-family: 'Figtree', Helvetica, Arial, sans-serif;
                    "
                  >
                    <strong>What happens next?</strong><br />
                    Our team will review this transaction within <%= reviewTime
                    %> working hours. If you did <strong>not</strong> initiate
                    this withdrawal, please contact our compliance team
                    immediately.
                  </p>

                  <a
                    href="mailto:helpdesk@plusplus.ng?subject=Flagged%20Withdrawal%20Inquiry%20-ID:%20<%= transactionId %>"
                    style="
                      display: inline-block;
                      background: #facc15;
                      color: #111827;
                      padding: 12px 32px;
                      border-radius: 9999px;
                      text-decoration: none;
                      font-weight: 600;
                      font-size: 14px;
                      font-family: 'Figtree', Helvetica, Arial, sans-serif;
                    "
                  >
                    Contact Compliance Team
                  </a>
                </td>
              </tr>
            </table>

            <table
              width="100%"
              cellspacing="0"
              cellpadding="0"
              border="0"
              class="content-body"
              style="
                background-color: #1a1a1a;
                color: #ffffff;
                padding: 40px;
                text-align: center;
              "
            >
              <tr>
                <td align="center">
                  <img
                    src="cid:padiplus_logo"
                    alt="Padi Plus"
                    width="30"
                    height="30"
                    style="margin-bottom: 10px"
                  />
                  <p
                    style="font-size: 14px; margin: 0 0 20px 0; color: #ffffff"
                  >
                    &copy; <%= new Date().getFullYear() %> Padi Plus Inc.
                  </p>

                  <p style="font-size: 12px; color: #9ca3af; margin: 0">
                    Questions?
                    <a href="mailto:helpdesk@plusplus.ng" style="color: #ffffff"
                      >helpdesk@plusplus.ng</a
                    >
                  </p>

                  <div
                    style="
                      display: none !important;
                      visibility: hidden;
                      mso-hide: all;
                      font-size: 1px;
                      color: #1a1a1a;
                      line-height: 1px;
                      max-height: 0px;
                      max-width: 0px;
                      opacity: 0;
                      overflow: hidden;
                    "
                  >
                    Reference: <%= Math.random().toString(36).substring(7) %>
                  </div>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
