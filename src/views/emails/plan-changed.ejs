<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body
    style="
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f4f4f5;
      padding: 40px 16px;
      color: #333;
      margin: 0;
      line-height: 1.6;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background: #004174;
          padding: 36px 32px 32px;
          text-align: center;
        "
      >
        <div style="margin-bottom: 20px">
          <div style="display: inline-block; background: #fff; border-radius: 8px; padding: 8px 20px">
            <img
              src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
              alt="CVtoCAREER"
              style="display: block; width: 149px; height: 32px"
            />
          </div>
        </div>
        <h1
          style="
            margin: 0;
            color: #fff;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.3px;
          "
        >
          Your CVtoCAREER Plan Has Been Updated
        </h1>
      </div>

      <!-- Body -->
      <div style="padding: 36px 32px">
        <p style="margin: 0 0 16px; font-size: 15px">
          Hello <strong><%= name %></strong>,
        </p>

        <p style="margin: 0 0 24px; font-size: 15px">
          We're pleased to confirm that your CVtoCAREER plan has been successfully updated.
        </p>

        <!-- Plan box -->
        <div
          style="
            background: #eef6fc;
            border-left: 4px solid #004174;
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 28px;
          "
        >
          <p style="margin: 0 0 12px; font-size: 15px; font-weight: 700; color: #004174">
            Plan Details
          </p>
          <p style="margin: 0 0 6px; font-size: 14px; color: #333">
            <strong>Previous Plan:</strong> <%= previousPlan %>
          </p>
          <p style="margin: 0 0 6px; font-size: 14px; color: #333">
            <strong>Current Plan:</strong> <%= planTo %>
          </p>
          <p style="margin: 0; font-size: 14px; color: #333">
            <strong>Expiry Date:</strong> <%= subEndDate %>
          </p>
        </div>

        <p style="margin: 0 0 16px; font-size: 15px; color: #333">
          No action is required from you at this time. Our team will continue managing your campaign and progressing your applications as normal under your updated plan.
        </p>

        <p style="margin: 0 0 28px; font-size: 15px; color: #333">
          Thank you for continuing to trust CVtoCAREER with your career journey.
        </p>

        <!-- CTA -->
        <div style="text-align: center; margin-bottom: 32px">
          <a
            href="<%= frontendUrl %>/dashboard"
            style="
              background: #008ed3;
              color: #fff;
              text-decoration: none;
              font-weight: 600;
              padding: 14px 36px;
              border-radius: 6px;
              display: inline-block;
              font-size: 15px;
            "
          >
            Go to Dashboard &rarr;
          </a>
        </div>

        <p style="margin: 0 0 28px; font-size: 14px; color: #555">
          If you have any questions about your updated plan, please feel free to reach out. Is there anything you would like us to clarify?
        </p>

        <!-- Signature -->
        <p style="margin: 0 0 4px; font-size: 14px; color: #555">Best regards,</p>
        <p style="margin: 0; font-size: 15px; font-weight: 700; color: #333">The CVtoCAREER Team</p>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 20px 32px;
          background: #f8f9fa;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <div style="margin-bottom: 16px">
          <a href="https://facebook.com/cvtocareer" style="display: inline-block; margin: 0 6px; text-decoration: none">
            <img src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png" alt="Facebook" style="width: 28px; height: 28px; display: inline-block; border-radius: 50%" />
          </a>
          <a href="https://x.com/cvtocareer" style="display: inline-block; margin: 0 6px; text-decoration: none">
            <img src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png" alt="X" style="width: 28px; height: 28px; display: inline-block; border-radius: 50%" />
          </a>
          <a href="https://instagram.com/cvtocareer" style="display: inline-block; margin: 0 6px; text-decoration: none">
            <img src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png" alt="Instagram" style="width: 28px; height: 28px; display: inline-block; border-radius: 50%" />
          </a>
          <a href="https://linkedin.com/company/cvtocareer" style="display: inline-block; margin: 0 6px; text-decoration: none">
            <img src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png" alt="LinkedIn" style="width: 28px; height: 28px; display: inline-block; border-radius: 50%" />
          </a>
        </div>
        <p style="margin: 0 0 8px; font-size: 12px; color: #9ca3af">
          &copy; <%= currentYear %> CVtoCAREER PTY LTD. All rights reserved.
        </p>
        <div>
          <a href="<%= frontendUrl %>/dashboard/account?run=unsubscribe" style="color: #9ca3af; text-decoration: none; font-size: 11px; margin: 0 8px">Unsubscribe</a>
          <span style="color: #d1d5db">&bull;</span>
          <a href="<%= frontendUrl %>/privacy-policy" style="color: #9ca3af; text-decoration: none; font-size: 11px; margin: 0 8px">Privacy Policy</a>
          <span style="color: #d1d5db">&bull;</span>
          <a href="<%= frontendUrl %>" style="color: #9ca3af; text-decoration: none; font-size: 11px; margin: 0 8px">Website</a>
        </div>
      </div>
    </div>
  </body>
</html>
