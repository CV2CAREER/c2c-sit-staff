<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        color: #474747;
        width: 100%;
        background-color: #fff;
        text-align: justify;
        line-height: 1.6;
      }

      .header {
        background-color: #004174;
        background:
          linear-gradient(90deg, #004174 0%, #00568f 100%);
        width: 100%;
        height: 112px;
        text-align: center;
        display: table;
      }

      .header-content {
        display: table-cell;
        vertical-align: middle;
      }

      .header img {
        width: 149px;
        height: 32px;
      }

      .content {
        font-family: "Poppins", sans-serif;
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }

      .title {
        font-size: 22px;
        font-weight: 500;
        line-height: 32px;
        color: #474747;
        text-transform: capitalize;
        margin-bottom: 20px;
      }

      .body-content {
        background-color: #fff;
        width: 100%;
      }

      .body-content p {
        margin-bottom: 16px;
      }

      .body-content b {
        display: block;
        margin-bottom: 16px;
      }

      .signature {
        margin-top: 24px;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 32px 16px;
        text-align: center;
      }

      .footer-logo {
        margin-bottom: 16px;
      }

      .footer-logo img {
        width: 35px;
        height: 25px;
      }

      .social-links {
        margin: 16px auto;
      }

      .social-links a {
        text-decoration: none;
        vertical-align: middle;
        display: inline-block;
        padding: 0 6px;
      }

      .social-links img {
        width: 24px;
        height: 24px;
        border: 0;
      }

      .copyright {
        margin: 16px auto;
      }

      .footer-links {
        margin-top: 16px;
      }

      .footer-links a {
        text-decoration: none;
        color: #a3a3a3;
      }

      .credential-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 15px;
        margin: 10px 0;
      }

      .site-name {
        font-weight: bold;
        color: #004174;
        font-size: 16px;
        margin-bottom: 8px;
      }

      .label {
        font-weight: 600;
        color: #6b7280;
        font-size: 12px;
        text-transform: uppercase;
      }

      .value {
        font-family: monospace;
        background: #f3f4f6;
        padding: 4px 8px;
        border-radius: 4px;
        display: inline-block;
        margin-top: 4px;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <div class="header">
      <div class="header-content">
        <img
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
          alt="CV To Career"
        />
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <h1 class="title">Your Jobsites Credentials</h1>

      <div class="body-content">
        <b>Hi <%= firstname %>,</b>

        <p>Your job board accounts have been set up successfully. Below are your login credentials for each job site:</p>

        <% credentials.forEach(function(cred) { %>
        <div class="credential-card">
            <div class="site-name"><%= cred.name %></div>
            <div>
                <span class="label">Email:</span><br>
                <span class="value"><%= cred.email %></span>
            </div>
            <div style="margin-top: 10px;">
                <span class="label">Password:</span><br>
                <span class="value"><%= cred.password %></span>
            </div>
        </div>
        <% }); %>

        <p style="margin-top: 20px;">You can use these credentials to log in directly to each job site. We recommend changing your passwords after your first login.</p>
        
        <p>If you have any questions or need assistance, please don't hesitate to contact our support team.</p>

        <div class="signature">
          <p>Best regards,<br />The CVtoCAREER Team</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-logo">
        <img
          src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/laigusbucket/bea7d3a092f0710b014b1f203.png?GoogleAccessId=firebase-adminsdk-f76vf%40cvtocareer-394713.iam.gserviceaccount.com&Expires=4070905200&Signature=gWB9jqmAcwN9nLbugMdOj%2FD0BROrGRX4a8qnGa9cZGuOkc0Z2M9itk0pzUtoUtyedrxv%2B2hO%2BFqDqlduJ6J7WqVBAJ3wQ17oe72S5BwTvRXEY3Q7OM%2B9wuxsFsSwgrtfldf79sly6nIJQCXqb94FDFL661YxCbeGN%2BIq0j2volsUvmKtParJXXLo3LO%2BBmOms1nVf6HHldXbD%2FfMno5f%2FB8wj%2FLDF%2FvMk5LfTsISh0kSOXmvfRNQvktImOAH2rTt%2B6ejVByGrxstPLhViGGI0BSIWEOn0oFaihxHK3Lo%2B3T0WePp5Q0PoYFrERpTtGReyZFGIVc%2Bs%2B9PReVzHoL86g%3D%3D"
          alt="CVtoCAREER"
        />
      </div>

      <div class="social-links">
        <a href="https://facebook.com">
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png"
            alt="Facebook"
          />
        </a>
        <a href="https://x.com">
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png"
            alt="X"
          />
        </a>
        <a href="https://youtube.com">
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_yt.png"
            alt="YouTube"
          />
        </a>
        <a href="mailto:deliveryteam@cvtocareer.com">
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_gmail.png"
            alt="Email"
          />
        </a>
        <a href="https://instagram.com">
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png"
            alt="Instagram"
          />
        </a>
        <a href="https://linkedin.com">
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png"
            alt="LinkedIn"
          />
        </a>
      </div>

      <p class="copyright">
        © 2026 CVtoCAREER. All rights reserved.
      </p>
    </div>
  </body>
</html>