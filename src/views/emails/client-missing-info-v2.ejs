<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="margin:0; padding:0; font-family:'Poppins',Arial,Helvetica,sans-serif; width:100%; background-color:#F3F4F6; line-height:1.6; -webkit-font-smoothing:antialiased;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#F3F4F6;">
      <tr>
        <td align="center" style="padding:0;">
          <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:560px; width:100%; margin:40px auto; background-color:#FFFFFF; border-radius:16px; overflow:hidden; border:1px solid #E5E7EB; box-shadow:0 1px 2px rgba(0,0,0,0.05), 0 4px 12px rgba(0,0,0,0.06);">
            <tr>
              <td style="background-color:#10365A; padding:32px 32px; text-align:center; border-bottom:3px solid #0E7FC2;">
                <img
                  src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
                  alt="CVtoCAREER Logo"
                  style="display:block; margin:0 auto; width:149px; height:32px; border:0; outline:none;"
                />
              </td>
            </tr>
            <tr>
              <td style="padding:40px 36px;">
                <h1 style="margin:0 0 20px; font-size:24px; font-weight:700; color:#1F2937; line-height:1.3; letter-spacing:-0.01em;">Action Required: Information Needed</h1>
                <div style="font-size:14px; color:#4B5563;">
                  <p style="margin:0 0 18px;">Dear <strong><%= name %></strong>,</p>
                  <p style="margin:0 0 18px;">We need some additional information to continue processing your application. Please review and complete the details requested below.</p>
                  <% if (personalMessage) { %>
                  <div style="background-color:#F0FDF8; border-left:5px solid #0F9D6C; padding:16px 20px; border-radius:8px; margin:20px 0; font-style:italic; color:#1F2937; font-size:14px;">
                    <p style="margin:0;"><%= personalMessage %></p>
                  </div>
                  <% } %>
                  <div style="background-color:#F0F7FF; border-left:5px solid #0E7FC2; padding:16px 20px; border-radius:8px; margin:20px 0; font-size:14px;">
                    <p style="margin:0; font-weight:500; color:#1F2937;">Template: <strong><%= templateName %></strong></p>
                    <% if (fieldLabels) { %>
                    <p style="margin:6px 0 0; font-weight:400; color:#4B5563;">Fields requested: <%= fieldLabels %></p>
                    <% } %>
                    <% if (refereeCount) { %>
                    <p style="margin:6px 0 0; font-weight:400; color:#4B5563;">Referees required: <%= refereeCount %></p>
                    <% } %>
                  </div>
                  <p style="margin:0 0 18px;">Please click the button below to review and complete the information. This link will take you directly to the secure form.</p>
                  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0;">
                    <tr>
                      <td style="border-radius:10px;">
                        <a href="<%= updateMissingInfoUrl %>" style="display:inline-block; padding:15px 32px; background-color:#0E7FC2; background-image:linear-gradient(135deg, #0E7FC2 0%, #0B5A94 100%); color:#ffffff; text-decoration:none; border-radius:10px; font-weight:600; font-size:15px; letter-spacing:0.01em; text-align:center; box-shadow:0 2px 8px rgba(14,127,194,0.25);">Complete Information</a>
                      </td>
                    </tr>
                  </table>
                  <p style="margin-top:14px; font-size:12px; color:#9CA3AF; word-break:break-all;">Or copy this link into your browser:<br /><%= updateMissingInfoUrl %></p>
                  <hr style="height:1px; background-color:#E5E7EB; border:none; margin:24px 0;" />
                  <p style="font-size:14px; color:#4B5563; margin:0 0 18px;">If you have any questions or need assistance, please don't hesitate to reach out to our support team at <a href="mailto:deliveryteam@cvtocareer.com" style="color:#0E7FC2;">deliveryteam@cvtocareer.com</a>.</p>
                  <p style="font-size:14px; color:#4B5563; margin:20px 0 0;">Kind regards,<br />The CVtoCAREER Team</p>
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px; border-top:1px solid #E5E7EB; text-align:center;">
                <p style="margin:0 0 4px; font-size:12px; color:#9CA3AF;">&copy; <%= currentYear %> CVtoCAREER. All rights reserved.</p>
                <p style="margin:0; font-size:12px; color:#9CA3AF;"><a href="mailto:deliveryteam@cvtocareer.com" style="color:#9CA3AF; text-decoration:underline;">deliveryteam@cvtocareer.com</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
