<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Poppins", Arial, sans-serif; color: #474747; width: 100%; background-color: #f4f4f5; line-height: 1.6; }
      .content { padding: 32px 20px; max-width: 600px; margin: 0 auto; }
      .title { font-size: 22px; font-weight: 500; line-height: 32px; color: #474747; margin-bottom: 20px; }
      .body-content p { margin-bottom: 16px; }
      .alert-box { background-color: #fff8e1; border-left: 4px solid #f59e0b; padding: 16px 20px; border-radius: 4px; margin: 24px 0; }
      .alert-box p { margin: 0; font-weight: 500; }
      .btn { display: inline-block; margin-top: 24px; padding: 14px 28px; background-color: #004174; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 15px; }
      .url-note { margin-top: 12px; font-size: 13px; color: #6b7280; word-break: break-all; }
      .signature { margin-top: 32px; }
      .contact-link { color: #004174; text-decoration: none; }
    </style>
  </head>
  <body>
    <!-- Header -->
    <div style="background-color: #004174; padding: 28px 32px; text-align: center">
      <img
        src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
        alt="CVtoCAREER Logo"
        style="display: block; margin: 0 auto 16px auto; width: 149px; height: 32px"
      />
    </div>

    <!-- Content -->
    <div class="content">
      <h1 class="title">Action Required: Information Needed</h1>

      <div class="body-content">
        <p>Dear <strong><%= name %></strong>,</p>

        <p>
          We need some additional information to continue processing your
          application. Please review and complete the details requested below.
        </p>

        <% if (personalMessage) { %>
        <div
          style="
            background-color: #f0fdf8;
            border-left: 4px solid #0f9d6c;
            padding: 16px 20px;
            border-radius: 4px;
            margin: 24px 0;
            font-style: italic;
          "
        >
          <p style="margin: 0"><%= personalMessage %></p>
        </div>
        <% } %>

        <div class="alert-box">
          <p>Template: <strong><%= templateName %></strong></p>
          <% if (fieldLabels) { %>
          <p style="margin: 6px 0 0; font-weight: 400; color: #6b7280">
            Fields requested: <%= fieldLabels %>
          </p>
          <% } %> <% if (refereeCount) { %>
          <p style="margin: 6px 0 0; font-weight: 400; color: #6b7280">
            Referees required: <%= refereeCount %>
          </p>
          <% } %>
        </div>

        <p>
          Please click the button below to review and complete the information.
          This link will take you directly to the secure form.
        </p>

        <a href="<%= updateMissingInfoUrl %>" class="btn"
          >Complete Information</a
        >

        <p class="url-note">
          Or copy this link into your browser:<br />
          <%= updateMissingInfoUrl %>
        </p>

        <p style="margin-top: 24px">
          If you have any questions or need assistance, please don't hesitate to
          reach out to our support team at
          <a href="mailto:deliveryteam@cvtocareer.com" class="contact-link"
            >deliveryteam@cvtocareer.com</a
          >.
        </p>

        <div class="signature">
          <p>Kind regards,<br />The CVtoCAREER Team</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div
      style="
        padding: 24px 32px;
        background-color: #f9fafb;
        border-top: 1px solid #e5e7eb;
        text-align: center;
      "
    >
      <div style="margin-bottom: 20px">
        <a
          href="https://facebook.com/cvtocareer"
          style="display: inline-block; margin: 0 6px; text-decoration: none"
        >
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png"
            alt="Facebook"
            style="width: 28px; height: 28px; display: inline-block"
          />
        </a>
        <a
          href="https://x.com/cvtocareer"
          style="display: inline-block; margin: 0 6px; text-decoration: none"
        >
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png"
            alt="X"
            style="width: 28px; height: 28px; display: inline-block"
          />
        </a>
        <a
          href="https://youtube.com/cvtocareer"
          style="display: inline-block; margin: 0 6px; text-decoration: none"
        >
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_yt.png"
            alt="YouTube"
            style="width: 28px; height: 28px; display: inline-block"
          />
        </a>
        <a
          href="mailto:support@cvtocareer.com"
          style="display: inline-block; margin: 0 6px; text-decoration: none"
        >
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_gmail.png"
            alt="Email"
            style="width: 28px; height: 28px; display: inline-block"
          />
        </a>
        <a
          href="https://instagram.com/cvtocareer"
          style="display: inline-block; margin: 0 6px; text-decoration: none"
        >
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png"
            alt="Instagram"
            style="width: 28px; height: 28px; display: inline-block"
          />
        </a>
        <a
          href="https://linkedin.com/company/cvtocareer"
          style="display: inline-block; margin: 0 6px; text-decoration: none"
        >
          <img
            src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png"
            alt="LinkedIn"
            style="width: 28px; height: 28px; display: inline-block"
          />
        </a>
      </div>

      <p style="margin: 0 0 12px; font-size: 12px; color: #9ca3af">
        &copy; <%= currentYear %> CVtoCAREER. All rights reserved.
      </p>

      <div style="margin: 8px 0">
        <a
          href="mailto:deliveryteam@cvtocareer.com"
          style="
            color: #9ca3af;
            text-decoration: none;
            font-size: 11px;
            margin: 0 8px;
          "
          >deliveryteam@cvtocareer.com</a
        >
      </div>
    </div>
  </body>
</html>
