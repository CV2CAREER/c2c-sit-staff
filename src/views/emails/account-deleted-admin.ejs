<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="margin: 0; padding: 0; font-family: 'Poppins', Arial, sans-serif; width: 100%; background-color: #F3F4F6; line-height: 1.6; -webkit-font-smoothing: antialiased;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F3F4F6;">
      <tr>
        <td align="center">
          <div style="max-width: 560px; margin: 40px auto; background-color: #FFFFFF; border-radius: 16px; overflow: hidden; border: 1px solid #E5E7EB;">
            <div style="background-color: #10365A; padding: 32px 32px; text-align: center; border-bottom: 3px solid #0E7FC2;">
              <img
                src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2Fjobsite-credential-logo.png?alt=media&token=9d81b484-ab4b-41f0-b7cb-d88f2287b340"
                alt="CVtoCAREER Logo"
                style="display: block; margin: 0 auto; width: 149px; height: 32px;"
              />
            </div>

            <div style="padding: 40px 36px;">
              <div style="background-color: #FEF2F2; border-left: 5px solid #DC2626; border-radius: 8px; padding: 20px; margin: 0 0 24px; text-align: center;">
                <p style="margin: 0; font-weight: 600; color: #1F2937; font-size: 16px;">Account permanently deleted &mdash; delivery team notice</p>
              </div>

              <div style="font-size: 14px; color: #4B5563;">
                <p style="margin: 0 0 18px;">Hi team,</p>

                <p style="margin: 0 0 18px;">A client account has just been <strong>permanently deleted</strong>. This action cannot be undone.</p>

                <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; padding: 16px 20px; border-radius: 8px; margin: 20px 0;">
                  <p style="margin: 0 0 6px; color: #4B5563;"><strong>Client:</strong> <%= clientName %></p>
                  <p style="margin: 0 0 6px; color: #4B5563;"><strong>Email:</strong> <%= clientEmail %></p>
                  <p style="margin: 0; color: #4B5563;"><strong>Purged by:</strong> <%= purgedBy %></p>
                </div>

                <div style="background-color: #FFFBEB; border-left: 5px solid #F59E0B; padding: 16px 20px; border-radius: 8px; margin: 20px 0; color: #1F2937;">
                  <p style="margin: 0;">
                    All user data and dependent records have been removed. Confirm any external systems (Zoho, mailing lists, etc.) reflect the deletion.
                  </p>
                </div>

                <div style="height: 1px; background-color: #E5E7EB; margin: 24px 0;"></div>

                <p style="margin: 0; font-size: 14px; color: #4B5563;">&mdash; CVtoCAREER System</p>
              </div>
            </div>

            <div style="padding: 20px 32px; border-top: 1px solid #E5E7EB; text-align: center;">
              <p style="margin: 0; font-size: 12px; color: #9CA3AF;">
                &copy; <%= currentYear %> CVtoCAREER. All rights reserved.
              </p>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
