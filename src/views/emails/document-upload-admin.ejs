<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Document Upload - Admin Notification</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        color: #474747;
        width: 100%;
        background-color: #fff;
        text-align: justify;
        line-height: 1.6;
      }

      .header {
        background-color: #004174;
        width: 100%;
        height: 112px;
        text-align: center;
        display: table;
      }

      .header-content {
        display: table-cell;
        vertical-align: middle;
      }

      .header img {
        width: 149px;
        height: 32px;
      }

      .content {
        font-family: "Poppins", sans-serif;
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }

      .title {
        font-size: 22px;
        font-weight: 500;
        line-height: 32px;
        color: #474747;
        margin-bottom: 20px;
      }

      .body-content {
        background-color: #fff;
        width: 100%;
      }

      .body-content p {
        margin-bottom: 16px;
      }

      .info-box {
        background-color: #f0f7fc;
        border-left: 4px solid #004174;
        padding: 16px;
        margin: 20px 0;
      }

      .info-box p {
        margin-bottom: 8px;
      }

      .info-box p:last-child {
        margin-bottom: 0;
      }

      .btn {
        display: inline-block;
        background-color: #004174;
        color: #fff;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 16px;
      }

      .signature {
        margin-top: 24px;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 32px 16px;
        text-align: center;
      }

      .footer-logo img {
        width: 35px;
        height: 25px;
      }

      .copyright {
        margin: 16px auto;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
      <div style="background-color: #004174; padding: 28px 32px; text-align: center">
        <img 
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801" 
          alt="CVtoCAREER Logo" 
          style="display: block; margin: 0 auto 16px auto; width: 149px; height: 32px"
        />
      </div>

    <!-- Content -->
    <div class="content">
      <h1 class="title">New Document Upload Received</h1>

      <div class="body-content">
        <p>A new document upload has been received from a user.</p>

        <div class="info-box">
          <p><strong>User Details:</strong></p>
          <p><strong>Name:</strong> <%= name %></p>
          <p><strong>Email:</strong> <%= email %></p>
        </div>

        <p>
          The user has uploaded their resume/cover letter and is awaiting review.
          Please log in to the admin dashboard to review and process the documents.
        </p>

        <a href="<%= link %>" class="btn">View User Documents</a>

        <div class="signature">
          <p>Best regards,<br />CVtoCAREER System</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
      <div
        style="
          padding: 16px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>
      </div>
  </body>
</html>