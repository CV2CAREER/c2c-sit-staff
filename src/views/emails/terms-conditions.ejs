<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500&family=Poppins&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        color: #474747;
        width: 100%;
        background-color: #fff;
        text-align: justify;
        line-height: 1.6;
      }

      .header {
        background-color: #004174;
        background:
          linear-gradient(90deg, #004174 0%, #00568f 100%);
        width: 100%;
        height: 112px;
        text-align: center;
        display: table;
      }

      .header-content {
        display: table-cell;
        vertical-align: middle;
      }

      .header img {
        width: 149px;
        height: 32px;
      }

      .content {
        font-family: "Poppins", sans-serif;
        padding: 20px;
        max-width: 600px;
        margin: 0 auto;
      }

      .title {
        font-size: 22px;
        font-weight: 500;
        line-height: 32px;
        color: #474747;
        text-transform: capitalize;
        margin-bottom: 20px;
      }

      .body-content {
        background-color: #fff;
        width: 100%;
      }

      .body-content p {
        margin-bottom: 16px;
      }

      .body-content b {
        display: block;
        margin-bottom: 16px;
      }

      .signature {
        margin-top: 24px;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 32px 16px;
        text-align: center;
      }

      .footer-logo {
        margin-bottom: 16px;
      }

      .footer-logo img {
        width: 35px;
        height: 25px;
      }

      .social-links {
        margin: 16px auto;
      }

      .social-links a {
        text-decoration: none;
        vertical-align: middle;
        display: inline-block;
        padding: 0 6px;
      }

      .social-links img {
        width: 24px;
        height: 24px;
        border: 0;
      }

      .copyright {
        margin: 16px auto;
      }

      .footer-links {
        margin-top: 16px;
      }

      .footer-links a {
        text-decoration: none;
        color: #a3a3a3;
      }

      .contact-link {
        color: #004174;
        text-decoration: none;
      }

      .highlight-box {
        background-color: #f0f7ff;
        border-left: 4px solid #004174;
        padding: 16px;
        margin: 20px 0;
      }

      .attachment-note {
        background-color: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 8px;
        padding: 16px;
        margin: 20px 0;
      }

      .attachment-note strong {
        color: #856404;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
      <div style="background-color: #004174; padding: 28px 32px; text-align: center">
        <img 
          src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801" 
          alt="CVtoCAREER Logo" 
          style="display: block; margin: 0 auto 16px auto; width: 149px; height: 32px"
        />
      </div>

    <!-- Content -->
    <div class="content">
      <h1 class="title">Terms & Conditions - <%= planName %></h1>

      <div class="body-content">
        <b>Dear <%= name %>,</b>

        <p>
          Thank you for subscribing to the <strong><%= planName %></strong> service at
          <a href="<%= frontendUrl %>" class="contact-link">CVtoCAREER</a>.
        </p>

        <p>
          Please find attached the Terms and Conditions document for your records.
          This document outlines the scope of services, limitations, refund policies,
          and other important information regarding your subscription.
        </p>

        <div class="attachment-note">
          <strong>📎 Attachment:</strong>
          <p>Your personalized Terms & Conditions PDF document is attached to this email.
          Please download and keep it for your records.</p>
        </div>

        <div class="highlight-box">
          <p><strong>Key Points to Remember:</strong></p>
          <ul style="margin-left: 20px; margin-top: 10px;">
            <li>Payments are non-refundable once job application automation has commenced</li>
            <li>CVtoCAREER does not guarantee callbacks for interviews or job offers</li>
            <li>Your service validity period: <strong><%= validityPeriod %></strong></li>
          </ul>
        </div>

        <p>
          If you have any questions about these Terms & Conditions, please do not hesitate
          to contact us at
          <a href="https://cvtocareer.com/contactus" class="contact-link">CVtoCAREER Support</a>.
        </p>

        <p>
          We look forward to supporting you on your career journey!
        </p>

        <div class="signature">
          <p>Best regards,<br />CVtoCAREER Team</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
      <div
        style="
          padding: 16px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>
      </div>
  </body>
</html>