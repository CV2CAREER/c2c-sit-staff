<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= action === 'start' ? 'Application Commenced' : 'Application Ended' %></title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f4f4f5;
      padding: 40px;
      color: #333;
      margin: 0;
      line-height: 1.6;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background-color: #008ed3;
          padding: 28px 32px;
          text-align: center;
        "
      >
        <!-- Logo container with white background -->
        <div
          style="
            background-color: #ffffff;
            display: inline-block;
            padding: 8px 20px;
            border-radius: 8px;
            margin-bottom: 16px;
          "
        >
          <img
            src="https://firebasestorage.googleapis.com/v0/b/cvtocareer-394713.appspot.com/o/laigusbucket%2FC2C.png?alt=media&token=2c05d23e-1974-4a83-8143-99c1b6b96801"
            alt="CVtoCAREER Logo"
            style="display: block; width: 149px; height: 32px"
          />
        </div>
        <h1 style="margin: 0; color: #fff; font-size: 22px">
          <%= action === 'start' ? 'Application Commenced' : 'Application Ended' %>
        </h1>
      </div>

      <!-- Body -->
      <div style="padding: 28px 32px">
        <p style="margin: 0 0 16px">Dear <strong><%= name %></strong>,</p>

        <% if (action === 'start') { %>
        <p style="margin: 0 0 16px">
          Great news! Your job application process has officially commenced at
          CVtoCAREER. Our team is actively working on your behalf to find the
          best opportunities for you.
        </p>
        <% } else { %>
        <p style="margin: 0 0 16px">
          We would like to inform you that your current application cycle at
          CVtoCAREER has ended.
        </p>
        <% } %>

        <!-- Status Box -->
        <div
          style="
            background-color: #f5f5f5;
            padding: 24px;
            border-radius: 6px;
            text-align: center;
            margin: 24px 0;
          "
        >
          <h2 style="margin: 0; font-size: 20px; color: #333">
            <%= action === 'start' ? '🚀 Application Commenced' : '⏸️ Application Ended' %>
          </h2>
        </div>

        <% if (action === 'start') { %>
        <p style="margin: 0 0 16px; font-size: 14px; color: #6b7280">
          You can log in to your dashboard to track the progress of your
          application and stay updated on any new developments.
        </p>
        <% } else { %>
        <p style="margin: 0 0 16px; font-size: 14px; color: #6b7280">
          Please reach out to our team if you have any questions or wish to
          discuss next steps for your career journey. We are here to help.
        </p>
        <% } %>

        <!-- CTA -->
        <div style="text-align: center; margin: 24px 0">
          <a
            href="<%= frontendUrl %>/dashboard"
            style="
              background-color: #008ed3;
              color: #fff;
              text-decoration: none;
              font-weight: 600;
              padding: 14px 32px;
              border-radius: 6px;
              display: inline-block;
              font-size: 15px;
            "
            >Go to Dashboard</a
          >
        </div>

        <p style="margin: 24px 0 0 0">
          Best regards,<br />
          <strong>The CVtoCAREER Team</strong>
        </p>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 24px 32px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <div style="margin-bottom: 20px">
          <a
            href="https://facebook.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_fb.png"
              alt="Facebook"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://x.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_x.png"
              alt="X"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://youtube.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_yt.png"
              alt="YouTube"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="mailto:support@cvtocareer.com"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_gmail.png"
              alt="Email"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://instagram.com/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_ig.png"
              alt="Instagram"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
          <a
            href="https://linkedin.com/company/cvtocareer"
            style="display: inline-block; margin: 0 6px; text-decoration: none"
          >
            <img
              src="https://storage.googleapis.com/cvtocareer-394713.appspot.com/footer/c2c_footer_linkedin.png"
              alt="LinkedIn"
              style="width: 28px; height: 28px; display: inline-block"
            />
          </a>
        </div>

        <p style="margin: 0 0 12px; font-size: 12px; color: #9ca3af">
          © <%= currentYear %> CVtoCAREER. All rights reserved.
        </p>

        <div style="margin: 8px 0">
          <a
            href="<%= frontendUrl %>/dashboard/account?run=unsubscribe"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Unsubscribe</a
          >
          <span style="color: #d1d5db">|</span>
          <a
            href="<%= frontendUrl %>/privacy-policy"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Privacy Policy</a
          >
          <span style="color: #d1d5db">|</span>
          <a
            href="<%= frontendUrl %>"
            style="
              color: #9ca3af;
              text-decoration: none;
              font-size: 11px;
              margin: 0 8px;
            "
            >Website</a
          >
        </div>
      </div>
    </div>
  </body>
</html>
