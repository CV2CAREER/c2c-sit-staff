<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="font-family: 'Segoe UI', Arial, sans-serif; background: #f4f4f5; padding: 32px 16px; color: #333; margin: 0; line-height: 1.6">
    <div style="max-width: 600px; margin: 0 auto; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08)">

      <div style="background: #b5760a; padding: 24px 32px; text-align: center">
        <p style="margin: 0 0 6px; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; color: rgba(255,255,255,0.65); text-transform: uppercase">CVtoCAREER</p>
        <h1 style="margin: 0; color: #fff; font-size: 18px; font-weight: 700">&#128176; CRP referral confirmed &mdash; $50 UNPAID</h1>
      </div>

      <div style="padding: 28px 32px">
        <p style="margin: 0 0 22px; font-size: 15px; color: #333">Dear Team,</p>

        <p style="margin: 0 0 10px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: #6b7280; text-transform: uppercase">Payout</p>

        <table style="width: 100%; border-collapse: collapse; font-size: 14px">
          <% if (typeof referralId !== 'undefined' && referralId) { %>
          <tr>
            <td style="padding: 9px 0; color: #555; width: 42%; border-bottom: 1px solid #f3f4f6"><strong>Referral ID</strong></td>
            <td style="padding: 9px 0; color: #333; border-bottom: 1px solid #f3f4f6"><%= referralId %></td>
          </tr>
          <% } %>
          <tr>
            <td style="padding: 9px 0; color: #555; border-bottom: 1px solid #f3f4f6"><strong>Referrer</strong></td>
            <td style="padding: 9px 0; color: #333; border-bottom: 1px solid #f3f4f6"><%= referrerName %><% if (typeof referrerId !== 'undefined' && referrerId) { %> &middot; <%= referrerId %><% } %></td>
          </tr>
          <tr>
            <td style="padding: 9px 0; color: #555; border-bottom: 1px solid #f3f4f6"><strong>PayID</strong></td>
            <td style="padding: 9px 0; color: #333; border-bottom: 1px solid #f3f4f6"><% if (typeof payId !== 'undefined' && payId) { %><%= payId %><% } else { %><span style="color:#9ca3af">Not yet provided</span><% } %></td>
          </tr>
          <tr>
            <td style="padding: 9px 0; color: #555; border-bottom: 1px solid #f3f4f6"><strong>Referred</strong></td>
            <td style="padding: 9px 0; color: #333; border-bottom: 1px solid #f3f4f6"><%= refereeName %> &mdash; subscription live<% if (typeof referredSubDate !== 'undefined' && referredSubDate) { %> <%= referredSubDate %><% } %></td>
          </tr>
          <tr>
            <td style="padding: 9px 0; color: #555; border-bottom: 1px solid #f3f4f6"><strong>Confirmed</strong></td>
            <td style="padding: 9px 0; color: #333; border-bottom: 1px solid #f3f4f6">automatically. No claim, no approval.</td>
          </tr>
          <tr>
            <td style="padding: 9px 0; color: #555"><strong>Amount &middot; Status</strong></td>
            <td style="padding: 9px 0; font-weight: 700; color: #b5760a">$50 &middot; UNPAID</td>
          </tr>
        </table>

        <p style="margin: 22px 0 0; font-size: 13px; color: #555; font-style: italic; border-top: 1px solid #f3f4f6; padding-top: 16px">
          The platform does not move money. Pay it, then mark it paid &mdash; or it stays on the owed report and gets chased.
        </p>

        <div style="margin-top: 24px">
          <a href="<%= adminUrl %>" style="background: #b5760a; color: #fff; text-decoration: none; font-weight: 600; padding: 12px 28px; border-radius: 6px; display: inline-block; font-size: 14px">
            View Referrals in Admin &rarr;
          </a>
        </div>
      </div>

      <div style="padding: 16px 32px; background: #f8f9fa; border-top: 1px solid #e5e7eb; text-align: center">
        <p style="margin: 0; font-size: 12px; color: #9ca3af">&copy; <%= currentYear %> CVtoCAREER PTY LTD &mdash; Internal Use Only</p>
      </div>
    </div>
  </body>
</html>
