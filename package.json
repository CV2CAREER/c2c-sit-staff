{
  "name": "c2c-staff-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/server.ts\"",
    "postinstall": "playwright install chromium",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:plan-resolution": "tsx scripts/test-plan-resolution.ts",
    "start": "node build/server.js",
    "build": "tsc && copyfiles -u 1 \"src/views/**/*\" \"src/public/**/*\" build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "reencrypt:pii:aes256": "tsx src/scripts/reencrypt-cast5-to-aes256.ts",
    "schema-usage:scan": "tsx src/scripts/generate-schema-table-usage.ts && tsx src/scripts/generate-schema-impact-index.ts",
    "reencrypt:pii:aes256:verify": "tsx src/scripts/reencrypt-cast5-to-aes256.ts --verify",
    "check-all": "",
    "prepare": "node scripts/setup-hooks.js"
  },
